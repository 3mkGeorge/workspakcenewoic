# Next Chip storefront environment (copy to .env.local for development).
# Real secrets never go in this file or in any NEXT_PUBLIC_* variable.
# COMMERCE_MODE and NEXT_CHIP_ALLOW_INDEXING are read at build time as well as
# run time: rebuild (npm run build) after changing them.

# demo   = sample catalog from local fixtures, simulated checkout (default when unset)
# synced = real catalog pushed by StorePro into PostgreSQL. Stage 1: checkout,
#          shipping rates and payment options are still demo; no order reaches StorePro.
# Any other value is treated as a configuration error (the site never falls back to demo data).
COMMERCE_MODE=demo

# Public site URL used for canonical links, sitemap and structured data.
SITE_URL=http://localhost:3100

# --- Synchronized catalog (COMMERCE_MODE=synced) -------------------------------
# PostgreSQL connection string (server-side only). Run `npm run db:migrate` after setting it.
# DATABASE_URL=postgres://nextchip:CHANGE_ME@db.example.internal:5432/nextchip
# DATABASE_SSL=require          # verify the server certificate (recommended for hosted databases)
# DATABASE_POOL_MAX=5

# Shared HMAC secret for StorePro → website requests (at least 32 characters).
# Must equal StorePro's NEXT_CHIP_SYNC_SECRET. During rotation, put the old value
# in NEXT_CHIP_SYNC_SECRET_PREVIOUS until StorePro uses the new one.
# NEXT_CHIP_SYNC_SECRET=
# NEXT_CHIP_SYNC_SECRET_PREVIOUS=

# Optional
# NEXT_CHIP_SYNC_MAX_BYTES=8388608          # largest accepted snapshot body (bytes)
# NEXT_CHIP_CATALOG_STALE_MINUTES=120       # after this long without a sync, shoppers see a "may have changed" notice
# NEXT_CHIP_ALLOW_INDEXING=false            # synced mode only; keep false while checkout is a demo

# Remote image hosts allowed for product images (https, comma-separated). Synced photos are
# served from this site's /media/ path and need no entry here.
# NEXT_PUBLIC_IMAGE_HOSTS=
