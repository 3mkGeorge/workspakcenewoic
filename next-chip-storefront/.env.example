# Next Chip storefront environment (copy to .env.local). No secrets belong in this file.

# demo     = sample catalog, simulated checkout, nothing is sent to StorePro (default)
# storepro = live StorePro API (NOT IMPLEMENTED YET - see STStorePro_INTEGRATION.md)
COMMERCE_MODE=demo

# Public site URL used for canonical links, sitemap and structured data.
SITE_URL=http://localhost:3100

# --- Future StorePro integration (server-side only) ------------------------------
# Never prefix these with NEXT_PUBLIC_: they must not reach the browser.
# STOREPRO_API_URL=https://storepro-api.example.internal
# STOREPRO_API_TOKEN=
# STOREPRO_API_TIMEOUT_MS=8000
