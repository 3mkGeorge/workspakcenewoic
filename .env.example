# StorePro → Next Chip website catalog sync (Stage 1: catalog only).
#
# Put these either in the Windows environment of the account that runs StorePro,
# or in instance\web-sync.env (that folder is never committed and is not part of
# StorePro backups). Environment variables override the file.
# Never commit a real secret. Restart StorePro after changing these values.

# Master switch. Scheduled and manual syncs only run when this is true.
NEXT_CHIP_SYNC_ENABLED=false

# Website origin only (no path). Must be https:// in production.
# http:// is accepted only for localhost testing.
NEXT_CHIP_SYNC_URL=https://shop.example.com

# Shared HMAC secret: at least 32 random characters, identical to the
# website's NEXT_CHIP_SYNC_SECRET. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXT_CHIP_SYNC_SECRET=

# Optional tuning
NEXT_CHIP_SYNC_INTERVAL_MINUTES=15     # scheduled sync interval (5–1440)
NEXT_CHIP_SYNC_MAX_PER_ORDER=5         # default per-order cap sent to the website (1–99)
NEXT_CHIP_SYNC_TIMEOUT_SECONDS=20      # per HTTP request (5–120)
